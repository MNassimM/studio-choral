# Copy this file to `.env` and fill in real values for your local setup.
# Prisma supports the native PostgreSQL connection string format.
# See: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://butterfly:butterfly@localhost:5432/butterfly_choral?schema=public"

# MOCK / TEMPORAIRE (en attendant Auth.js) : email du compte de démonstration
# utilisé comme utilisateur courant (voir src/lib/auth/current-user.ts).
# Comptes disponibles, chacun illustrant un état différent de la page œuvre :
#   demo-aucun-achat@butterfly.test      — Choriste curieux   (aucun droit)
#   demo-alto-partiel@butterfly.test     — Choriste alto      (Messe en sol majeur, ALTO, 4/6 mouvements) [défaut]
#   demo-oeuvre-complete@butterfly.test  — Chef de chœur      (Messe en sol majeur, toutes voix, œuvre entière)
#   demo-multi-oeuvres@butterfly.test    — Choriste basse     (Messe en sol majeur BASS + Mille regretz toutes voix)
DEMO_USER_EMAIL="demo-multi-oeuvres@butterfly.test"
