# Copy this file to `.env` and fill in real values for your local setup.
# Prisma supports the native PostgreSQL connection string format.
# See: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://butterfly:butterfly@localhost:5432/butterfly_choral?schema=public"

# MOCK / TEMPORAIRE (en attendant Auth.js) : email du compte de démonstration
# utilisé comme utilisateur courant (voir src/lib/auth/current-user.ts).
# Comptes disponibles, chacun illustrant un état différent de la page œuvre :
#   demo-aucun-achat@butterfly.test      - Choriste curieux   (aucun droit)
#   demo-alto-partiel@butterfly.test     - Choriste alto      (Messe en sol majeur, ALTO, 4/6 mouvements) [défaut]
#   demo-oeuvre-complete@butterfly.test  - Chef de chœur      (Messe en sol majeur, toutes voix, œuvre entière)
#   demo-multi-oeuvres@butterfly.test    - Choriste basse     (Messe en sol majeur BASS + Mille regretz toutes voix)
DEMO_USER_EMAIL="demo-multi-oeuvres@butterfly.test"

# ─── Envoi d'e-mail (src/lib/email) ──────────────────────────────────────────
# Ces variables sont validées AU DÉMARRAGE (src/lib/email/env.ts) : une valeur
# manquante ou invalide fait échouer le serveur immédiatement, plutôt que de se
# découvrir au premier envoi.

# Transport à utiliser. OBLIGATOIRE, sans valeur par défaut : un défaut
# silencieux ferait qu'une variable absente ou mal orthographiée donne un
# système qui n'envoie rien, sans erreur.
#   "console" - n'envoie RIEN, écrit le message dans les logs serveur (dév)
#   "resend"  - envoi réel via Resend (exige RESEND_API_KEY ci-dessous)
EMAIL_TRANSPORT="console"

# Adresse d'expédition. OBLIGATOIRE quel que soit le transport (le transport
# console l'affiche aussi). En développement, le domaine de test Resend
# `onboarding@resend.dev` fonctionne sans configuration DNS ; en production,
# une adresse de votre propre domaine vérifié.
EMAIL_FROM_ADDRESS="onboarding@resend.dev"

# Nom d'expéditeur affiché. OPTIONNEL (purement cosmétique) : sans lui, seule
# l'adresse apparaît.
EMAIL_FROM_NAME="Butterfly Studio Choral"

# Clé API Resend. Requise UNIQUEMENT si EMAIL_TRANSPORT="resend" - inutile de
# posséder une clé pour développer avec le transport console.
# À créer sur https://resend.com/api-keys - ne jamais la committer.
# RESEND_API_KEY=""
