# Copy this file to `.env` and fill in real values for your local setup.
# Prisma supports the native PostgreSQL connection string format.
# See: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://butterfly:butterfly@localhost:5432/butterfly_choral?schema=public"

# ─── Authentification (src/lib/auth) ─────────────────────────────────────────
# Validées AU DÉMARRAGE (src/lib/auth/env.ts), même principe que le module
# e-mail : une valeur manquante fait échouer le serveur immédiatement.

# Secret de signature/chiffrement des jetons Auth.js. OBLIGATOIRE, minimum 32
# caractères. En générer un avec : npx auth secret
# Ne jamais committer la vraie valeur, ni la réutiliser entre environnements.
AUTH_SECRET=""

# URL absolue du site. OPTIONNELLE : Auth.js déduit l'URL de la requête
# entrante en développement comme en production sur la plupart des hébergeurs.
# À renseigner uniquement derrière un proxy qui réécrit l'hôte.
# AUTH_URL="https://butterfly-studio-choral.example"

# Identifiants du client OAuth Google. OPTIONNELS et exigés ensemble : sans les
# deux, le provider n'est pas configuré et le bouton disparaît de la page de
# connexion, ce qui permet de développer sans créer de projet Google Cloud.
# À créer dans Google Cloud Console, voir le rapport de mise en place pour les
# URI de redirection exactes à déclarer.
# Ne jamais committer de vraies valeurs.
# AUTH_GOOGLE_ID="votre-identifiant.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="votre-secret-client"

# Désactive la limitation de débit du formulaire de connexion. OPTIONNELLE, et
# lue UNIQUEMENT hors production : la condition est retirée du bundle de
# production à la compilation. À n'utiliser que ponctuellement en local, pour
# enchaîner des envois sans se bloquer soi même.
# Seuils appliqués : 3 demandes par adresse et par quart d'heure, 15 par adresse
# IP et par heure (voir src/lib/auth/env.ts).
# AUTH_RATE_LIMIT_DISABLED="true"

# ─── Envoi d'e-mail (src/lib/email) ──────────────────────────────────────────
# Ces variables sont validées AU DÉMARRAGE (src/lib/email/env.ts) : une valeur
# manquante ou invalide fait échouer le serveur immédiatement, plutôt que de se
# découvrir au premier envoi.

# Transport à utiliser. OBLIGATOIRE, sans valeur par défaut : un défaut
# silencieux ferait qu'une variable absente ou mal orthographiée donne un
# système qui n'envoie rien, sans erreur.
#   "console" - n'envoie RIEN, écrit le message dans les logs serveur (dév)
#   "resend"  - envoi réel via Resend (exige RESEND_API_KEY ci-dessous)
EMAIL_TRANSPORT="console"

# Adresse d'expédition. OBLIGATOIRE quel que soit le transport (le transport
# console l'affiche aussi). En développement, le domaine de test Resend
# `onboarding@resend.dev` fonctionne sans configuration DNS ; en production,
# une adresse de votre propre domaine vérifié.
EMAIL_FROM_ADDRESS="onboarding@resend.dev"

# Nom d'expéditeur affiché. OPTIONNEL (purement cosmétique) : sans lui, seule
# l'adresse apparaît.
EMAIL_FROM_NAME="Butterfly Studio Choral"

# Clé API Resend. Requise UNIQUEMENT si EMAIL_TRANSPORT="resend" - inutile de
# posséder une clé pour développer avec le transport console.
# À créer sur https://resend.com/api-keys - ne jamais la committer.
# RESEND_API_KEY=""

# ─── Stockage des fichiers audio (src/lib/storage) ───────────────────────────
# Validées AU DÉMARRAGE (src/lib/storage/env.ts), même principe que les modules
# e-mail et authentification : une valeur manquante fait échouer immédiatement.
# Il n'existe AUCUN transport de repli ni simulation locale, le module parle à
# Cloudflare R2 et à rien d'autre.

# Identifiant de compte Cloudflare. Compose l'adresse du service, de la forme
# https://<compte>.r2.cloudflarestorage.com
# Visible dans le tableau de bord R2, en haut à droite.
R2_ACCOUNT_ID=...

# Jeton d'API R2, à créer dans R2 puis "Manage API tokens". Restreindre le
# jeton au SEUL bucket ci-dessous, en lecture et écriture.
# Ne jamais committer ces valeurs.
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...

# Nom du bucket. Deux réglages à faire côté Cloudflare :
#   - une règle de cycle de vie qui purge le préfixe pending/ après 7 jours,
#     ce qui ramasse les fichiers téléversés puis jamais enregistrés ;
#   - une règle CORS autorisant PUT depuis l'origine du site, sans quoi le
#     téléversement direct depuis le navigateur sera refusé.
R2_BUCKET=...
