generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AudioType {
  SOLO
  PREDOMINANT
  TUTTI
  ACCOMPANIMENT
  PREVIEW
}

enum AccessScope {
  MOVEMENT
  WORK
}

enum VoiceCoverage {
  SINGLE_VOICE
  ALL_VOICES
}

enum MusicalPeriod {
  MEDIEVAL
  RENAISSANCE
  BAROQUE
  CLASSICAL
  ROMANTIC
  MODERN
  CONTEMPORARY
}

enum UserRole {
  USER
  ADMIN
}

enum GrantSource {
  PURCHASE
  MANUAL_GRANT
  PROMO
}

model Work {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  composer         String
  catalogueRef     String?        @map("catalogue_ref")
  shortDescription String?        @map("short_description")
  description      String?
  coverImageKey    String?        @map("cover_image_key")
  /// Année de composition, approximative pour l'ancien répertoire. NULL si
  /// aucune date fiable n'est établie - ne jamais deviner.
  composedYear     Int?           @map("composed_year")
  /// Courant musical. NULL si l'œuvre est en cours de catalogage.
  period           MusicalPeriod?
  /// Formation vocale (SATB, SATB div., SSAA...), saisie à la main -
  /// jamais déduite des AudioFile. Voir src/lib/works/voicing.ts.
  voicing          String?
  /// Vrai si chaque mouvement de l'oeuvre attend une piste d'accompagnement.
  hasAccompaniment Boolean        @default(false) @map("has_accompaniment")
  /// Langue du texte CHANTÉ (code ISO 639-1 : "fr", "la", "de", "en", "it"...),
  /// sans AUCUN rapport avec la langue d'interface du site. Voir
  /// src/lib/works/languages.ts pour les libellés français.
  language         String?
  isPublished      Boolean        @default(false) @map("is_published")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  movements    Movement[]
  products     Product[]
  translations WorkTranslation[]
  libraryItems LibraryItem[]

  @@index([period])
  @@map("works")
}

// Surcharges par langue d'une Work - jamais de colonnes suffixées (titleEn...) :
// ajouter une langue est une insertion de lignes, pas une migration. Le
// français reste la langue de référence, portée par Work elle-même.
model WorkTranslation {
  id               String  @id @default(cuid())
  workId           String  @map("work_id")
  /// Code de langue d'interface (ex. "en") - sans rapport avec Work.language
  /// (la langue du texte CHANTÉ). Voir src/lib/works/resolve-translation.ts.
  locale           String
  /// Slug localisé (ex. "mass-in-g-major"). Résolution : chercher d'abord ici
  /// pour la locale demandée, retomber sur Work.slug si absent.
  slug             String
  /// NULL = conserver le titre original (cas des incipits, ex. "Mille
  /// regretz", qui ne se traduisent jamais) - pas une traduction manquante.
  title            String?
  shortDescription String? @map("short_description")
  description      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([workId, locale])
  @@unique([locale, slug])
  @@map("work_translations")
}

model Movement {
  id        String   @id @default(cuid())
  workId    String   @map("work_id")
  slug      String
  title     String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  work         Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  audioFiles   AudioFile[]
  products     Product[]
  libraryItems LibraryItem[]

  @@unique([workId, slug])
  @@unique([workId, position])
  @@map("movements")
}

model Voice {
  id       String @id @default(cuid())
  code     String @unique
  label    String
  position Int

  audioFiles   AudioFile[]
  products     Product[]
  libraryItems LibraryItem[]

  @@map("voices")
}

model AudioFile {
  id              String    @id @default(cuid())
  movementId      String    @map("movement_id")
  voiceId         String?   @map("voice_id")
  type            AudioType
  storageKey      String    @map("storage_key")
  originalFilename String?  @map("original_filename")
  durationSeconds Int       @map("duration_seconds")
  mimeType        String    @map("mime_type")
  sizeBytes       Int?      @map("size_bytes")
  previewStartSec Int?      @map("preview_start_sec")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  movement Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  voice    Voice?   @relation(fields: [voiceId], references: [id])

  @@unique([movementId, voiceId, type])
  @@index([movementId])
  @@map("audio_files")
}

// Une offre achetable - jamais un fichier audio. Voir src/lib/products/invariants.ts
// pour les règles de cohérence scope/coverage <-> movementId/voiceId que Postgres
// ne peut pas exprimer nativement.
model Product {
  id            String        @id @default(cuid())
  sku           String        @unique
  name          String
  workId        String        @map("work_id")
  movementId    String?       @map("movement_id")
  voiceId       String?       @map("voice_id")
  scope         AccessScope
  coverage      VoiceCoverage
  priceCents    Int           @map("price_cents")
  currency      String        @default("EUR")
  /// Vrai quand l'offre est couverte par ses pistes audio, donc vendable.
  /// Calculé, jamais posé à la main. Voir src/lib/admin/product-activation.ts.
  isActive      Boolean       @default(true) @map("is_active")
  /// Vrai quand l'offre n'est plus engendrée par le catalogue, parce que son
  /// pupitre ou son mouvement a été retiré. Elle n'est jamais supprimée, un
  /// LibraryItem peut la référencer, mais elle sort de tous les calculs.
  isRetired     Boolean       @default(false) @map("is_retired")
  position      Int
  stripePriceId String?       @unique @map("stripe_price_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  work     Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  movement Movement? @relation(fields: [movementId], references: [id], onDelete: Cascade)
  voice    Voice?    @relation(fields: [voiceId], references: [id])

  @@unique([workId, movementId, voiceId, coverage])
  @@index([workId, isActive])
  @@map("products")
}

// Étendu pour l'adaptateur Prisma d'Auth.js v5 (@auth/prisma-adapter) :
// emailVerified/image sont les champs qu'il exige sur AdapterUser, accounts/
// sessions les relations qu'il requête par leur nom Prisma généré. Champs et
// contraintes vérifiés contre le schéma officiel de l'adaptateur (voir le
// rapport de migration) - pas de configuration Auth.js ni de code
// d'authentification ajoutés ici, seulement le schéma.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  /// Date de vérification de l'email (magic link / OAuth), NULL tant que non
  /// vérifié. Exigé par AdapterUser - jamais renseigné par la seed de démo.
  emailVerified DateTime? @map("email_verified")
  name          String?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts     Account[]
  sessions     Session[]
  libraryItems LibraryItem[]

  @@map("users")
}

/// Table de l'adaptateur Prisma d'Auth.js (@auth/prisma-adapter) - un lien
/// OAuth par (provider, providerAccountId). Les champs OAuth
/// (refresh_token, access_token, expires_at, token_type, scope, id_token,
/// session_state) restent en snake_case SANS @map : c'est le nom Prisma
/// littéral que l'adaptateur lit/écrit directement (type AdapterAccount de
/// @auth/core), pas une convention de mapping de colonne - les renommer en
/// camelCase casserait l'adaptateur silencieusement.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nom composite généré par Prisma : provider_providerAccountId - c'est
  // exactement la clé que PrismaAdapter().getUserByAccount()/unlinkAccount()
  // interrogent (where: { provider_providerAccountId }). Ne pas inverser
  // l'ordre des deux champs, le nom généré en dépend.
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Table de l'adaptateur Prisma d'Auth.js - une session active par
/// sessionToken. sessionToken doit rester un champ scalaire @unique (pas
/// composite) : l'adaptateur interroge where: { sessionToken } tel quel.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// Table de l'adaptateur Prisma d'Auth.js - jetons de vérification (magic
/// link, vérification d'email). @@unique([identifier, token]) génère le nom
/// composite identifier_token, exactement la clé que
/// useVerificationToken() interroge en suppression. `id` est superflu pour
/// l'adaptateur (qui le retire lui-même du résultat s'il est présent) mais
/// cohérent avec la convention id + contrainte unique du reste du schéma.
model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Le droit qu'un utilisateur détient sur une œuvre - contrepartie d'une
/// offre (Product) achetée, offerte ou obtenue par code promo. Sa structure
/// reprend volontairement celle de Product (mêmes scope/coverage,
/// mêmes règles de cohérence avec movementId/voiceId - voir
/// src/lib/library-items/invariants.ts, calqué sur
/// src/lib/products/invariants.ts).
///
/// DÉDUPLICATION SÉMANTIQUE NON TRAITÉE ICI : posséder « Alto - œuvre
/// entière » (scope WORK) rend redondant « Alto - Kyrie » (scope MOVEMENT),
/// mais aucune contrainte SQL ne peut exprimer cette relation d'inclusion.
/// Cette déduplication relève du code de lecture des droits (prochaine
/// étape, src/lib/access), pas de ce modèle ni de sa migration.
model LibraryItem {
  id         String        @id @default(cuid())
  userId     String        @map("user_id")
  workId     String        @map("work_id")
  /// NULL si scope = WORK (droit sur l'œuvre entière).
  movementId String?       @map("movement_id")
  /// NULL si coverage = ALL_VOICES.
  voiceId    String?       @map("voice_id")
  scope      AccessScope
  coverage   VoiceCoverage
  source     GrantSource   @default(PURCHASE)

  /// Colonne simple, SANS relation pour l'instant : PurchaseItem n'existe
  /// pas encore. La relation (et la contrainte de clé étrangère) sera
  /// ajoutée à l'étape Stripe, en même temps que les modèles Purchase et
  /// PurchaseItem.
  purchaseItemId String? @map("purchase_item_id")

  grantedAt DateTime  @default(now()) @map("granted_at")
  /// Retrait d'un droit (remboursement, litige) sans suppression de la
  /// ligne - l'historique doit rester consultable. Toute lecture de droits
  /// effectifs doit filtrer sur revokedAt: null.
  revokedAt DateTime? @map("revoked_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  work     Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  movement Movement? @relation(fields: [movementId], references: [id], onDelete: Cascade)
  voice    Voice?    @relation(fields: [voiceId], references: [id])

  // Postgres traite chaque NULL comme distinct : cet unique composite ne
  // protège que la combinaison MOVEMENT + SINGLE_VOICE (movementId ET
  // voiceId renseignés). Les trois autres combinaisons impliquent au moins
  // un NULL et échappent à cette contrainte - voir les index uniques
  // partiels ajoutés à la main dans la migration user_and_library_items,
  // sur le modèle de ceux de products/audio_files.
  @@unique([userId, workId, movementId, voiceId, coverage])
  @@index([userId, workId])
  @@index([userId])
  @@map("library_items")
}

/// Trace d'une demande de lien de connexion, servant uniquement à la
/// limitation de débit du formulaire.
///
/// Une ligne par tentative plutôt qu'un compteur incrémenté : compter des
/// lignes sur une fenêtre glissante évite la lecture suivie d'une écriture que
/// deux requêtes concurrentes pourraient entrelacer, et donne une fenêtre qui
/// glisse réellement au lieu de se réinitialiser d'un coup.
///
/// L'adresse e-mail n'est jamais stockée en clair. Seule une empreinte salée
/// est conservée, ce qui suffit à compter les tentatives d'une même adresse
/// sans constituer un registre des adresses ayant tenté de se connecter.
model SignInAttempt {
  id String @id @default(cuid())

  /// Nature de la clé comptée, "email" ou "ip", les deux limites étant
  /// indépendantes l'une de l'autre.
  scope String

  /// Empreinte SHA-256 de la clé, salée avec le secret d'authentification.
  keyHash String @map("key_hash")

  createdAt DateTime @default(now()) @map("created_at")

  // Index de comptage : il porte les trois colonnes de la requête de fenêtre
  // glissante, dans l'ordre où elles sont filtrées.
  @@index([scope, keyHash, createdAt])
  // Index de purge, utilisé par la suppression des lignes expirées.
  @@index([createdAt])
  @@map("sign_in_attempts")
}
