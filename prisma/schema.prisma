generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AudioType {
  SOLO
  PREDOMINANT
  TUTTI
  ACCOMPANIMENT
  PREVIEW
}

enum AccessScope {
  MOVEMENT
  WORK
}

enum VoiceCoverage {
  SINGLE_VOICE
  ALL_VOICES
}

enum MusicalPeriod {
  MEDIEVAL
  RENAISSANCE
  BAROQUE
  CLASSICAL
  ROMANTIC
  MODERN
  CONTEMPORARY
}

model Work {
  id               String         @id @default(cuid())
  slug             String         @unique
  title            String
  composer         String
  catalogueRef     String?        @map("catalogue_ref")
  shortDescription String?        @map("short_description")
  description      String?
  coverImageKey    String?        @map("cover_image_key")
  /// Année de composition, approximative pour l'ancien répertoire. NULL si
  /// aucune date fiable n'est établie — ne jamais deviner.
  composedYear     Int?           @map("composed_year")
  /// Courant musical. NULL si l'œuvre est en cours de catalogage.
  period           MusicalPeriod?
  /// Formation vocale (SATB, SATB div., SSAA...), saisie à la main —
  /// jamais déduite des AudioFile. Voir src/lib/works/voicing.ts.
  voicing          String?
  /// Langue du texte CHANTÉ (code ISO 639-1 : "fr", "la", "de", "en", "it"...),
  /// sans AUCUN rapport avec la langue d'interface du site. Voir
  /// src/lib/works/languages.ts pour les libellés français.
  language         String?
  isPublished      Boolean        @default(false) @map("is_published")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  movements Movement[]
  products  Product[]

  @@index([period])
  @@map("works")
}

model Movement {
  id        String   @id @default(cuid())
  workId    String   @map("work_id")
  slug      String
  title     String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  work       Work        @relation(fields: [workId], references: [id], onDelete: Cascade)
  audioFiles AudioFile[]
  products   Product[]

  @@unique([workId, slug])
  @@unique([workId, position])
  @@map("movements")
}

model Voice {
  id       String @id @default(cuid())
  code     String @unique
  label    String
  position Int

  audioFiles AudioFile[]
  products   Product[]

  @@map("voices")
}

model AudioFile {
  id              String    @id @default(cuid())
  movementId      String    @map("movement_id")
  voiceId         String?   @map("voice_id")
  type            AudioType
  storageKey      String    @map("storage_key")
  durationSeconds Int       @map("duration_seconds")
  mimeType        String    @map("mime_type")
  sizeBytes       Int?      @map("size_bytes")
  previewStartSec Int?      @map("preview_start_sec")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  movement Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  voice    Voice?   @relation(fields: [voiceId], references: [id])

  @@unique([movementId, voiceId, type])
  @@index([movementId])
  @@map("audio_files")
}

// Une offre achetable — jamais un fichier audio. Voir src/lib/products/invariants.ts
// pour les règles de cohérence scope/coverage <-> movementId/voiceId que Postgres
// ne peut pas exprimer nativement.
model Product {
  id            String        @id @default(cuid())
  sku           String        @unique
  name          String
  workId        String        @map("work_id")
  movementId    String?       @map("movement_id")
  voiceId       String?       @map("voice_id")
  scope         AccessScope
  coverage      VoiceCoverage
  priceCents    Int           @map("price_cents")
  currency      String        @default("EUR")
  isActive      Boolean       @default(true) @map("is_active")
  position      Int
  stripePriceId String?       @unique @map("stripe_price_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  work     Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  movement Movement? @relation(fields: [movementId], references: [id], onDelete: Cascade)
  voice    Voice?    @relation(fields: [voiceId], references: [id])

  @@unique([workId, movementId, voiceId, coverage])
  @@index([workId, isActive])
  @@map("products")
}
